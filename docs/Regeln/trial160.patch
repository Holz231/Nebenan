--- a/src/figure_steer.c
+++ b/src/figure_steer.c
@@ -470,6 +470,9 @@ bool nbMoveSteered( nbWorld* world, int index, nbFigure* f, float timeStep, b3Ve
 	b3Vec3 wish = b3MulSub( f->steer.velocity, b3Dot( f->steer.velocity, up ), up );
 	b3Vec3 asked = wish;
 	f->steeredSpeed = b3Length( wish );
+#ifdef NB_X_ARCH
+	float trialArc = 0.0f;
+#endif
 	if ( f->steer.faceVelocity )
 	{
 		// Facing where it moves, it goes across its heading and backward no faster than a step to the side or back, see
@@ -488,7 +491,24 @@ bool nbMoveSteered( nbWorld* world, int index, nbFigure* f, float timeStep, b3Ve
 				across = b3MulSV( side / sideLength, across );
 			}
 			along = b3MaxFloat( along, -back );
+#ifdef NB_X_ARCH
+			{
+				// trial of round 160: steered at a walk it walks on the way it faces while it turns, a bend, instead of
+				// nearly stopping until it faces where it wants to go
+				float wanted = b3Length( wish );
+				float walkShare = 0.0f;
+				if ( f->gaitOn && f->boneCount == nb_humanoidBoneCount && f->onGround )
+				{
+					walkShare = ( 1.0f - f->gaitRun ) * ( 1.0f - b3ClampFloat( ( wanted / scale - 2.0f ) / 0.5f, 0.0f, 1.0f ) );
+				}
+				b3Vec3 capped = b3MulAdd( across, along, forward );
+				b3Vec3 ahead = b3MulSV( NB_X_ARCH * wanted, forward );
+				wish = b3Add( b3MulSV( 1.0f - walkShare, capped ), b3MulSV( walkShare, ahead ) );
+				trialArc = walkShare;
+			}
+#else
 			wish = b3MulAdd( across, along, forward );
+#endif
 		}
 		asked = wish;
 	}
@@ -512,6 +532,18 @@ bool nbMoveSteered( nbWorld* world, int index, nbFigure* f, float timeStep, b3Ve
 	b3Vec3 change = b3Sub( wish, flat );
 	float rate = b3LengthSquared( wish ) > b3LengthSquared( flat ) ? def->acceleration : def->braking;
 	rate = b3MaxFloat( rate, 0.0f ) * ( f->onGround ? 1.0f : b3ClampFloat( def->airControl, 0.0f, 1.0f ) );
+#if defined( NB_X_ACC ) || defined( NB_X_ARC )
+	// trial of round 160: how much a humanoid is steered at a walk, 1 up to 2 m/s and 0 from 2.5 m/s, on the ground
+	float trialWalk = 0.0f;
+	if ( f->gaitOn && f->boneCount == nb_humanoidBoneCount && f->onGround )
+	{
+		trialWalk = ( 1.0f - f->gaitRun ) * ( 1.0f - b3ClampFloat( ( f->steeredSpeed / scale - 2.0f ) / 0.5f, 0.0f, 1.0f ) );
+	}
+#endif
+#ifdef NB_X_ACC
+	// trial: at a walk it speeds up with NB_X_ACC and brakes with NB_X_BRK times its acceleration and braking
+	rate *= 1.0f + trialWalk * ( ( b3LengthSquared( wish ) > b3LengthSquared( flat ) ? NB_X_ACC : NB_X_BRK ) - 1.0f );
+#endif
 	// At a walk it waits for its feet, see NB_WALK_STEERED: turning, it gets no faster while the leg it stands on loses
 	// its foot before the other foot lands, and stopping, it brakes gently while a foot lands where it aimed
 	f->walkTime = f->gaitOn && f->gaitRun <= 0.0f ? f->walkTime + timeStep : 0.0f;
@@ -540,7 +572,38 @@ bool nbMoveSteered( nbWorld* world, int index, nbFigure* f, float timeStep, b3Ve
 	}
 	float most = rate * timeStep;
 	float length = b3Length( change );
+#ifdef NB_X_ARC
+	// trial: at a walk, facing where it moves, the velocity turns to where it is wanted at NB_X_ARC radians per second and
+	// keeps its speed on the way, instead of braking and speeding up again: the figure walks a bend
+	bool bend = false;
+	if ( trialWalk > 0.0f && f->steer.faceVelocity )
+	{
+		float has = b3Length( flat ), wants = b3Length( wish );
+		if ( has > 0.3f * scale && wants > 0.3f * scale )
+		{
+			b3Vec3 from = b3MulSV( 1.0f / has, flat ), to = b3MulSV( 1.0f / wants, wish );
+			float cosine = b3ClampFloat( b3Dot( from, to ), -1.0f, 1.0f );
+			float sine = b3Dot( b3Cross( from, to ), up );
+			float angle = b3Atan2( sine == 0.0f && cosine < 0.0f ? 1.0e-6f : sine, cosine );
+			if ( fabsf( angle ) > 0.05f )
+			{
+				float step = b3ClampFloat( angle, -NB_X_ARC * timeStep, NB_X_ARC * timeStep );
+				float speed = has + b3ClampFloat( wants - has, -most, most );
+				b3Vec3 turned = b3RotateVector( b3MakeQuatFromAxisAngle( up, step ), from );
+				b3Vec3 bent = b3MulSV( speed, turned );
+				flat = b3Add( b3MulSV( 1.0f - trialWalk, length <= most ? wish : b3MulAdd( flat, most / length, change ) ),
+							  b3MulSV( trialWalk, bent ) );
+				bend = true;
+			}
+		}
+	}
+	if ( bend == false )
+	{
+		flat = length <= most ? wish : b3MulAdd( flat, most / length, change );
+	}
+#else
 	flat = length <= most ? wish : b3MulAdd( flat, most / length, change );
+#endif
 
 	// The ground: the probe from the lower center of the capsule down to the step height below the frame where the figure
 	// stands, a little below it in the air
@@ -703,6 +766,14 @@ bool nbMoveSteered( nbWorld* world, int index, nbFigure* f, float timeStep, b3Ve
 		b3Vec3 local = b3InvRotateVector( tilt, f->moveVelocity );
 		bool moving = local.x * local.x + local.z * local.z > NB_STEER_FACE_SPEED * NB_STEER_FACE_SPEED;
 		want = moving ? b3Atan2( local.x, local.z ) : heading;
+#ifdef NB_X_ARCH
+		// trial: walking a bend, it turns to where it is steered, not to where it moves
+		if ( trialArc > 0.5f )
+		{
+			b3Vec3 steered = b3InvRotateVector( tilt, f->steer.velocity );
+			want = b3Atan2( steered.x, steered.z );
+		}
+#endif
 	}
 	heading = nbTurnToward( heading, want, &f->headingRate, def, timeStep );
 
