index 9a465cd..757d49c 100644
--- a/src/figure.h
+++ b/src/figure.h
@@ -612,6 +612,9 @@ typedef struct nbFigure
 	float gaitTurnSize;
 	float gaitSway;
 	float gaitCrouch;
+	float crossHeld;
+	b3Vec3 swingAside[2];
+	bool swingAsideSet[2];
 	// The velocity it was steered at in the last update, and for how long the root still goes down gently after that
 	// velocity jumped, in seconds, see NB_CROUCH_EASE in figure_steer.c
 	b3Vec3 steerBefore;
diff --git a/src/figure_steer.c b/src/figure_steer.c
index d3a499b..aaf35e6 100644
--- a/src/figure_steer.c
+++ b/src/figure_steer.c
@@ -998,6 +998,67 @@ bool nbMoveSteered( nbWorld* world, int index, nbFigure* f, float timeStep, b3Ve
 			heading = nbWrapAngle( f->heading + change );
 		}
 	}
+#ifdef NB_X_CROSS
+	if ( f->steer.faceVelocity && f->gaitOn && f->boneCount == nb_humanoidBoneCount )
+	{
+		float change = nbWrapAngle( heading - f->heading );
+		float room = FLT_MAX;
+		if ( change != 0.0f )
+		{
+			b3CosSin legs = b3ComputeCosSin( f->heading );
+			b3Vec3 offset = b3SubPos( f->feet[0].plant, f->feet[1].plant );
+			float across = offset.x * legs.cosine - offset.z * legs.sine;
+			float along = offset.x * legs.sine + offset.z * legs.cosine;
+			float apart = sqrtf( across * across + along * along );
+			float keep = NB_X_CROSS * scale;
+			if ( apart > keep )
+			{
+				float ratio = keep / apart;
+				float low = b3Atan2( ratio, sqrtf( b3MaxFloat( 1.0f - ratio * ratio, 0.0f ) ) );
+				float angle = b3Atan2( across, along );
+				if ( low <= angle && angle <= B3_PI - low )
+				{
+					room = change > 0.0f ? angle - low : B3_PI - low - angle;
+				}
+				else
+				{
+					bool down = angle > B3_PI - low || angle < -0.5f * B3_PI;
+					room = ( change > 0.0f ) == down ? FLT_MAX : 0.0f;
+				}
+			}
+		}
+#ifdef NB_X_CROSS_ASIDE
+		{
+			// going across where it faces, it does not wait: the legs would go sideways under it
+			b3Vec3 aside = b3RotateVector( f->frame.q, b3Vec3_axisX );
+			if ( fabsf( b3Dot( f->moveVelocity, aside ) ) > NB_X_CROSS_ASIDE * scale )
+			{
+				room = FLT_MAX;
+			}
+		}
+#endif
+		if ( fabsf( change ) <= room )
+		{
+			f->crossHeld = 0.0f;
+		}
+		else
+		{
+			f->crossHeld += timeStep;
+			if ( f->crossHeld <= NB_X_CROSS_HOLD )
+			{
+				heading = nbWrapAngle( f->heading + ( change > 0.0f ? room : -room ) );
+#ifdef NB_X_CROSS_STEP
+				// the foot on the outside of the turn steps round for it
+				int outside = change > 0.0f ? 1 : 0;
+				if ( f->footSwings[outside] == false )
+				{
+					f->footHolds[outside] = true;
+				}
+#endif
+			}
+		}
+	}
+#endif
 	f->heading = heading;
 	f->frame = nbMakeFrame( world, position, heading );
 
