+				 57.2958f * f->headingWant, 57.2958f * f->heading, 57.2958f * heading, f->turnAbout, f->footHolds[0], f->footHolds[1], f->faceWaits, f->faceHeld,
+				 f->footSwings[0], f->footSwings[1], f->swingAlong[0], f->swingAlong[1], 57.2958f * f->footPivot[0], 57.2958f * f->footPivot[1],
+				 57.2958f * nbWrapAngle( f->footHeading[0] - f->legHeading ), 57.2958f * nbWrapAngle( f->footHeading[1] - f->legHeading ) );
+	}
+#endif
 	f->heading = heading;
 	f->frame = nbMakeFrame( world, position, heading );
 
