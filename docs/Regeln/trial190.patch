diff --git a/src/figure_steer.c b/src/figure_steer.c
index 741ab85..612b6b9 100644
--- a/src/figure_steer.c
+++ b/src/figure_steer.c
@@ -1,3 +1,4 @@
+#include <stdio.h>
 // SPDX-License-Identifier: MIT
 
 // A figure that a program steers, see nbFigure_Steer, as a character controller after chapters 2 and 25.1 of the roadmap
@@ -1053,16 +1054,92 @@ bool nbMoveSteered( nbWorld* world, int index, nbFigure* f, float timeStep, b3Ve
 		// every second it goes 0.26 instead of 0.20 of its speed where it is steered, see SteerWalkAboutTest. Turning at
 		// once whatever the feet do, 1.01 s, the feet got 35 instead of 16 mm under the ground in sum. See NB_ABOUT_CREEP.
 		bool aboutTurns = f->turnAbout && b3LengthSquared( f->steer.velocity ) > 0.0f;
+#ifdef NB_X_COMMIT
+		// trial: (1) it turns to where it is steered whatever the feet do; (2) while a foot is farther into its swing it
+		// keeps the heading it has instead of turning back to where it moves; a value between 0 and 1: the swing counts
+		// as committed from there
+		bool aboutAsked = aboutTurns;
+		float commit = NB_X_COMMIT < 1.0f ? NB_X_COMMIT : NB_STOP_COMMIT;
+		for ( int k = 0; k < 2 && NB_X_COMMIT != 1.0f; ++k )
+		{
+			aboutTurns = aboutTurns && ( f->footSwings[k] == false || f->swingAlong[k] <= commit );
+		}
+		if ( NB_X_COMMIT == 2.0f && aboutAsked && aboutTurns == false )
+		{
+			want = heading;
+		}
+#else
 		for ( int k = 0; k < 2; ++k )
 		{
 			aboutTurns = aboutTurns && ( f->footSwings[k] == false || f->swingAlong[k] <= NB_STOP_COMMIT );
 		}
+#endif
 		if ( bends || aboutTurns )
 		{
 			// Walking a bend, it turns to where it is steered, not to where it moves: it moves the way it faces
 			b3Vec3 steered = b3InvRotateVector( tilt, f->steer.velocity );
 			want = b3Atan2( steered.x, steered.z );
 		}
+#ifdef NB_X_WAY
+		// trial: turning about, it turns the way that keeps its legs uncrossed: to the right where its left foot stands
+		// ahead of the right one by more than NB_X_WAY meters as the turn begins, to the left where the right one
+		// does; a swinging foot counts where it lands. Chosen once for the turn, and kept until less than a quarter turn
+		// is left
+#ifdef NB_X_WAY_NEW
+		// trial: a turn-about steered more than a quarter turn off the one it chose for is a new one
+		b3Vec3 askedNow = b3InvRotateVector( tilt, f->steer.velocity );
+		float askedWay = b3Atan2( askedNow.x, askedNow.z );
+		if ( f->aboutChosen && fabsf( nbWrapAngle( askedWay - f->aboutFor ) ) > 0.5f * B3_PI )
+		{
+			f->aboutChosen = false;
+		}
+#endif
+		if ( f->turnAbout == false )
+		{
+			f->aboutWay = 0.0f;
+			f->aboutChosen = false;
+		}
+		else if ( f->aboutChosen == false )
+		{
+			f->aboutChosen = true;
+#ifdef NB_X_WAY_NEW
+			f->aboutFor = askedWay;
+#endif
+			b3CosSin legs = b3ComputeCosSin( f->heading );
+			b3Pos left = f->footSwings[0] ? f->feet[0].target : f->feet[0].plant;
+			b3Pos right = f->footSwings[1] ? f->feet[1].target : f->feet[1].plant;
+			b3Vec3 offset = b3SubPos( left, right );
+			float along = offset.x * legs.sine + offset.z * legs.cosine;
+			f->aboutWay = along > NB_X_WAY * scale ? -1.0f : ( along < -NB_X_WAY * scale ? 1.0f : 0.0f );
+#ifdef NB_X_WAY_SWING
+			// trial: a foot that swings as the turn begins will stand ahead of the other one
+			if ( f->footSwings[0] != f->footSwings[1] )
+			{
+				f->aboutWay = f->footSwings[0] ? -1.0f : 1.0f;
+			}
+#endif
+#ifdef NB_X_WAY_REAR
+			// trial: with both feet on the ground the one behind lifts next and will stand ahead; with NB_X_WAY_REAR
+			// above zero only where the clock has it lift within that share of a cycle
+			if ( f->footSwings[0] == false && f->footSwings[1] == false )
+			{
+				f->aboutWay = -f->aboutWay;
+			}
+#endif
+		}
+		if ( aboutTurns && f->aboutWay != 0.0f )
+		{
+			float left = nbWrapAngle( want - heading );
+			if ( left * f->aboutWay < 0.0f && fabsf( left ) > 0.5f * B3_PI )
+			{
+				want = nbWrapAngle( heading + f->aboutWay * 0.9f * B3_PI );
+			}
+			else if ( fabsf( left ) >= B3_PI - 0.001f )
+			{
+				want = nbWrapAngle( heading + f->aboutWay * 0.9f * B3_PI );
+			}
+		}
+#endif
 	}
 	heading = nbTurnToward( heading, want, &f->headingRate, def, timeStep );
 
