 	b3Vec3 hips[2];
+#ifdef NB_X_ABOUT_FOOT
+	// trial: how far the foot farthest ahead stands or lands ahead of where it stands at rest, along the way of the capsule
+	f->footAhead = 0.0f;
+	if ( f->stairWeight <= 0.0f && run <= 0.0f && speed > 0.01f * scale )
+	{
+		for ( int k = 0; k < 2; ++k )
+		{
+			if ( f->footSwings[k] && f->swingAlong[k] < NB_GAIT_AIM )
+			{
+				continue;
+			}
+			b3Pos at = f->footSwings[k] ? f->feet[k].target : f->feet[k].plant;
+			f->footAhead =
+				b3MaxFloat( f->footAhead, b3Dot( b3SubPos( at, nbClipAnkle( f, clips + k, f->feet + k ) ), velocity ) / speed );
+		}
+	}
+#endif
 	// Stopping out of a walk, the capsule brakes for the foot ahead, see NB_HALT_LOW
 	f->halts = f->stops && f->stairWeight <= 0.0f && run <= 0.0f;
 	f->haltRate = 0.0f;
