@@ -6250,8 +6286,23 @@ static void nbSteerFeet( const nbWorld* world, int index, nbFigure* f, const nbC
 					b3Vec3 toesNow = b3RotateVector( legQ, b3RotateVector( nbHeadingQuat( twist ), toes ) );
 					b3Vec3 toHip = b3SubPos( b3TransformWorldPoint( f->frame, hips[k] ), foot->plant );
 					float middle = b3Dot( sole, toes );
+#ifdef NB_X_HEEL
+					// trial: behind the ankle the hip takes the point toward the edge of the heel, and the toes lift
+					float heelMost = -1.0f;
